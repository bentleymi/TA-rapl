<dashboard version="1.1" theme="light">
  <label>TA-rapl Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype rapl:metrics); series prefixed 'rapl.'.</description>
  <row>
    <panel type="html">
      <html><![CDATA[<div style="border:1px solid #cc7a00;background:#fff7ea;border-radius:6px;padding:10px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:12px">
<span style="font-weight:700;color:#b35c00">Commercial Use</span>
<span>Commercial or production use of TA-rapl requires a paid license. Evaluation, personal, and lab use is free. See the BentleyPC Commercial License for full terms.</span>
<a href="https://bentleypc.com/TA-TA-rapl/" target="_blank" rel="noopener" style="background:#cc7a00;color:#fff;padding:7px 16px;border-radius:5px;font-weight:700;text-decoration:none">Buy License</a>
<a href="https://bentleypc.com/TA-TA-rapl/LICENSE.html" target="_blank" rel="noopener" style="color:#b35c00;font-weight:600;text-decoration:underline">License &amp; Terms</a>
</div>]]></html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Powercap domains &amp; power chips (counts)</title>
      <chart>
        <search>
          <query>| mstats avg("rapl.*count") as "v*" where index=metrics by metric_name span=5m
| rename v* as "rapl.*count"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Power draw (W, per chip/hwmon)</title>
      <chart>
        <search>
          <query>| mstats avg("rapl.*power1_watts") as "v*" where index=metrics by metric_name span=5m
| rename v* as "rapl.*power1_watts"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Energy in power domain (uJ cumulative)</title>
      <chart>
        <search>
          <query>| mstats avg("rapl.pc_*_energy_uj") as "v*" where index=metrics by metric_name span=5m
| rename v* as "rapl.pc_*_energy_uj"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
</dashboard>
